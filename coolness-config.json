{
    "description": "Model data for the word-coolness scorer. Single representation shared by coolness.py (canonical engine, generates coolness-report.json) and coolness-score.js (browser mirror on deploys.html). tests/test-coolness.js keeps the two engines in lockstep. Edit values here, run `python3 coolness.py --report`, and commit both files together.",
    "weights": {
        "pronounceability": 1.5,
        "flow": 1.0,
        "energy": 1.0,
        "phonesthemes": 1.25,
        "novelty": 1.0,
        "anchors": 1.5,
        "brevity": 0.75
    },
    "weightLabels": {
        "pronounceability": "Pronounceability: every onset and coda cluster is a legal English one",
        "flow": "Flow: sonority rises into each vowel and falls after it",
        "energy": "Energy: bright, punchy sounds (v, z, k, front vowels) over mushy ones",
        "phonesthemes": "Phonesthemes: sound-symbolic prefixes and endings (gl- light, sn- nose, -ibe vibe)",
        "novelty": "Novelty: sound pairs in the fresh zone - neither boringly common nor unpronounceably rare",
        "anchors": "Anchors: sounds like the cool-word list, unlike the uncool-word list",
        "brevity": "Brevity: one or two syllables land hardest"
    },
    "formulas": [
        {
            "id": "balanced",
            "name": "Balanced",
            "note": "House default: every metric counts, association and legality lead.",
            "weights": { "pronounceability": 1.5, "flow": 1.0, "energy": 1.0, "phonesthemes": 1.25, "novelty": 1.0, "anchors": 1.5, "brevity": 0.75 }
        },
        {
            "id": "brandable",
            "name": "Brandable",
            "note": "Naming research: processing fluency (easy-to-pronounce names are preferred; Alter & Oppenheimer 2006) plus sound symbolism in brand names (Klink 2000) - short, legal, bright.",
            "weights": { "pronounceability": 2.5, "flow": 1.0, "energy": 1.5, "phonesthemes": 1.0, "novelty": 0.75, "anchors": 0.5, "brevity": 2.0 }
        },
        {
            "id": "wordlike",
            "name": "Wordlike",
            "note": "Phonotactic probability and wordlikeness (Vitevitch & Luce 2004; Coleman & Pierrehumbert 1997): could this pass as native English? Novelty barely counts.",
            "weights": { "pronounceability": 2.5, "flow": 2.0, "energy": 0.5, "phonesthemes": 0.5, "novelty": 0.25, "anchors": 0.75, "brevity": 0.75 }
        },
        {
            "id": "euphonic",
            "name": "Euphonic",
            "note": "Phonaesthetics (Crystal 1995, the 'tremulous' tradition): smooth sonority contours and clean syllables outrank punch and fashion.",
            "weights": { "pronounceability": 2.0, "flow": 2.5, "energy": 0.5, "phonesthemes": 1.25, "novelty": 0.5, "anchors": 0.5, "brevity": 0.25 }
        },
        {
            "id": "edge",
            "name": "Edge",
            "note": "Nonword surprise (Westbury et al. 2016: improbable nonwords amuse): maximize the fresh zone and energy, tolerate weak association.",
            "weights": { "pronounceability": 0.75, "flow": 0.5, "energy": 1.75, "phonesthemes": 1.0, "novelty": 2.5, "anchors": 0.25, "brevity": 1.0 }
        },
        {
            "id": "zeitgeist",
            "name": "Zeitgeist",
            "note": "Association-led: coolness as cultural neighborhood (the vibe-coding effect). Anchor similarity dominates; edit the anchor lists to retune the era.",
            "weights": { "pronounceability": 1.0, "flow": 0.5, "energy": 1.25, "phonesthemes": 1.5, "novelty": 0.75, "anchors": 2.5, "brevity": 1.5 }
        },
        {
            "id": "poet",
            "name": "Poet",
            "note": "Sound patterning as image (the phonestheme tradition, Firth 1930 onward): clusters that paint, contours that carry, and a lyrical anchor vocabulary.",
            "weights": { "pronounceability": 1.0, "flow": 1.75, "energy": 0.75, "phonesthemes": 2.5, "novelty": 1.25, "anchors": 0.75, "brevity": 0.5 },
            "anchors": {
                "cool": ["shimmer", "lull", "velvet", "ember", "hush", "murmur", "luminous", "gossamer", "amber", "dusk", "willow", "echo", "opal", "silver", "meadow", "twilight"],
                "uncool": ["grunt", "blunt", "clunk", "smack", "gunk", "crud", "thud", "mush"]
            }
        },
        {
            "id": "psychologist",
            "name": "Psychologist",
            "note": "Memory science: optimal distinctiveness - fluent enough to process easily, surprising enough to stick (processing fluency plus isolation/novelty effects).",
            "weights": { "pronounceability": 2.0, "flow": 1.0, "energy": 1.0, "phonesthemes": 0.75, "novelty": 2.0, "anchors": 0.5, "brevity": 1.5 }
        },
        {
            "id": "genalpha",
            "name": "Gen alpha",
            "note": "Playground field notes: short, punchy, high-energy, and cool exactly insofar as it sounds like current kid slang.",
            "weights": { "pronounceability": 0.75, "flow": 0.25, "energy": 2.0, "phonesthemes": 0.75, "novelty": 1.25, "anchors": 2.25, "brevity": 2.0 },
            "anchors": {
                "cool": ["rizz", "gyat", "skibidi", "sigma", "bussin", "drip", "slay", "yeet", "bet", "sus", "goated", "fire", "lit", "cap", "aura", "mog"],
                "uncool": ["groovy", "swell", "nifty", "snazzy", "dandy", "golly", "neato", "hip"]
            }
        },
        {
            "id": "boomer",
            "name": "Boomer",
            "note": "Mid-century cool: jazz-age and rock-era slang, where smooth beats sharp and the kids' words sound like noise.",
            "weights": { "pronounceability": 1.5, "flow": 1.75, "energy": 0.75, "phonesthemes": 1.0, "novelty": 0.5, "anchors": 2.25, "brevity": 1.0 },
            "anchors": {
                "cool": ["groovy", "hip", "swell", "neat", "keen", "snazzy", "nifty", "mellow", "funky", "jazzy", "smooth", "boss", "ace", "dandy"],
                "uncool": ["rizz", "gyat", "skibidi", "yeet", "bussin", "sus", "drip"]
            }
        },
        {
            "id": "streetwise",
            "name": "Streetwise",
            "note": "Street register, hip-hop and skate lineage: effortless, low-key, crisp; corny is the cardinal sin.",
            "weights": { "pronounceability": 1.0, "flow": 1.0, "energy": 1.5, "phonesthemes": 1.0, "novelty": 0.75, "anchors": 2.25, "brevity": 1.5 },
            "anchors": {
                "cool": ["dope", "fresh", "fly", "tight", "chill", "slick", "smooth", "wavy", "drip", "ice", "lowkey", "crisp", "steez", "swag", "gnarly"],
                "uncool": ["corny", "lame", "wack", "basic", "stale", "square"]
            }
        }
    ],
