# The one publish list: everything in the repository ships to the host
# except the paths below. Read by .github/workflows/deploy.yml and deploy.sh
# through --filter='merge deploy/rsync-filter', alongside --delete and
# --delete-excluded, so the host holds exactly the product files.
# tests/test-deploy.js reads this file too; keep patterns to plain
# (unanchored, no '/', '**', '?', or '[') names and '*' globs.

- .git
- .gitignore
- .cursorignore
- .cursor
- .github
- .ast-grep
- .vscode
- .dev
- config.json
- config.example.json
- tests
- types
- demos
- deploy
- node_modules
- __pycache__
- *.pyc
- *.md
- *.txt
- *.sh
- *.py
- tsconfig.json
- sgconfig.yml
- package.json
- package-lock.json
- dev-server.js
- pipeline-*.svg
- screenshot-*.png

# deploy-telemetry.json belongs to .github/workflows/deploy-telemetry.yml,
# which regenerates it by merging the live copy's history. The publish
# never deletes the host's copy (P) and never sends a local one (-).
P deploy-telemetry.json
- deploy-telemetry.json
